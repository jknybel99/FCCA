# Docker Environment Variables Example
# Copy this file to .env and customize for your deployment

# Timezone
TZ=America/Chicago

# User/Group IDs (for running container as specific user)
# Uncomment and set to your user ID if you have permission issues
# UID=1000
# GID=1000

# PulseAudio Server (if using PulseAudio)
# PULSE_SERVER=unix:/run/user/1000/pulse/native

# Database URL (optional, defaults to SQLite)
DATABASE_URL=sqlite:///./school_bell.db

# Application Settings
PYTHONUNBUFFERED=1

# Port Mapping (change if 8000 is already in use)
# HOST_PORT=8000
# CONTAINER_PORT=8000

# Network Mode (uncomment to use host network for easier audio access)
# NETWORK_MODE=host

# Audio Device (default: /dev/snd)
# AUDIO_DEVICE=/dev/snd

# Log Level
# LOG_LEVEL=INFO
